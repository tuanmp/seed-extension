{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "env": {}
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "uv *": "allow",
      "git *": "allow",
      "rm *": "ask",
      "git rm *": "ask"
    },
    "webfetch": "allow"
  }
}
